{
  "name": "core-bridge",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Turbo Module exposing the Rust core (core/crates/inventory-core) to React Native, generated by uniffi-bindgen-react-native.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KristopherTadlock/home_inventory_app.git",
    "directory": "packages/core-bridge"
  },
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "react-native": "./src/index.tsx",
  "scripts": {
    "ubrn:android": "ubrn build android --and-generate --release --config ubrn.config.yaml"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-6",
    "uniffi-bindgen-react-native": "0.31.0-6"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "codegenConfig": {
    "name": "CoreBridgeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.opt.corebridge"
    }
  }
}
